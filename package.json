{
  "name": "@remotebrowser/sdk",
  "version": "0.2.1",
  "description": "Node.js SDK for Remote Browser",
  "type": "module",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "types": "./index.d.ts",
  "bin": {
    "remotebrowser": "bin.js"
  },
  "files": [
    "index.js",
    "client.js",
    "browsers.js",
    "errors.js",
    "cli.js",
    "bin.js",
    "index.d.ts",
    "client.d.ts",
    "browsers.d.ts",
    "errors.d.ts"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"*_tests.js\"",
    "format": "oxfmt \"*.{js,json,md}\"",
    "typecheck": "oxlint --type-aware",
    "build:types": "node -e \"for (const f of require('fs').readdirSync('.')) if (f.endsWith('.d.ts')) require('fs').rmSync(f)\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build:types"
  },
  "keywords": [
    "remotebrowser",
    "browser",
    "cdp",
    "sdk"
  ],
  "homepage": "https://remotebrowser.ai",
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "~26.1.2",
    "oxfmt": "~0.75.0",
    "oxlint": "~1.75.0",
    "oxlint-tsgolint": "~7.0.2001",
    "typescript": "~6.0.3"
  }
}
